{
  "name": "rd",
  "version": "0.0.23",
  "description": "RD Pos-System-Desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/degetmateo/pos-system-desktop"
  },
  "main": "dist/desktop/electron.main.js",
  "private": true,
  "scripts": {
    "postinstall": "pnpm run rebuild:electron",
    "dev": "pnpm run build && pnpm run rebuild:electron && electron-forge start",
    "build:server": "tsc -p tsconfig.server.json",
    "build:ui": "vite build",
    "build": "tsc -p tsconfig.server.json && vite build",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "start": "pnpm run build && pnpm run rebuild:electron && electron-forge start",
    "test": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs run",
    "test:watch": "cross-env ELECTRON_RUN_AS_NODE=1 electron ./node_modules/vitest/vitest.mjs",
    "package": "pnpm run build && pnpm run rebuild:electron && electron-forge package",
    "make": "pnpm run build && pnpm run rebuild:electron && electron-forge make",
    "start:prod": "pnpm run package && .\\out\\rd-win32-x64\\rd.exe",
    "release": "pnpm run build && pnpm run rebuild:electron && electron-forge publish",
    "publish": "pnpm run build && pnpm run rebuild:electron && electron-forge publish"
  },
  "keywords": [],
  "author": "degetmateo",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron-forge/cli": "^7.10.2",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/publisher-github": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^3.7.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.27",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/node-cron": "^3.0.11",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "lodash": "^4.18.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "better-sqlite3": "^12.6.0",
    "chart.js": "^4.6.1",
    "electron-squirrel-startup": "^1.0.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "keytar": "^7.9.0",
    "lucide-react": "^1.62.0",
    "multer": "^2.0.2",
    "navigo": "^8.11.1",
    "node-cron": "^4.2.1",
    "pdfmake": "^0.2.23",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tom-select": "^2.6.2",
    "update-electron-app": "^3.1.2",
    "uuid": "^13.0.0"
  }
}